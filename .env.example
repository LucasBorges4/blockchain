# Blockchain Consensus Lab — Environment Variables Template
# Copy to .env and customize as needed

# ============================================================================
# GENERAL SETTINGS
# ============================================================================
# Project root (auto-detected if not set)
# BCL_ROOT=/home/lucas/github/blockchain

# Experiment configuration
BCL_EXPERIMENT_REPETITIONS=5
BCL_EXPERIMENT_TIMEOUT=3600
BCL_RANDOM_SEED=42

# Output formats
BCL_OUTPUT_FORMATS=csv,json
BCL_RAW_DATA_DIR=./reports/raw
BCL_PROCESSED_DATA_DIR=./reports/processed
BCL_FIGURES_DIR=./reports/figures
BCL_TABLES_DIR=./reports/tables

# ============================================================================
# REPOSITORY SETTINGS
# ============================================================================
# Clone depth (0 = full history, 1 = shallow)
BCL_CLONE_DEPTH=0

# Specific commit/branch/tag overrides (empty = default branch)
# Format: REPO_NAME=commitish
# BCL_BITCOIN_COMMIT=
# BCL_ETHEREUM_CONSENSUS_SPECS_COMMIT=
# BCL_HOTSTUFF_COMMIT=
# BCL_SUI_COMMIT=
# BCL_AVALANCHE_COMMIT=
# BCL_GO_ALGORAND_COMMIT=
# BCL_COMETBFT_COMMIT=
# BCL_AGAVE_COMMIT=
# BCL_OUROBOROS_CONSENSUS_COMMIT=
# BCL_HONEYBADGER_COMMIT=
# BCL_RUSTY_KASPA_COMMIT=
# BCL_STELLAR_CORE_COMMIT=

# ============================================================================
# BUILD SETTINGS
# ============================================================================
# Parallel jobs for compilation
BCL_BUILD_JOBS=$(shell nproc)

# Build type: Release, Debug, RelWithDebInfo
BCL_BUILD_TYPE=Release

# Skip failing builds (continue with others)
BCL_BUILD_CONTINUE_ON_ERROR=true

# Use Docker for isolated builds (requires docker-compose)
BCL_USE_DOCKER=false

# Docker builder images
BCL_DOCKER_CPP_IMAGE=ubuntu:22.04
BCL_DOCKER_GO_IMAGE=golang:1.22-bookworm
BCL_DOCKER_RUST_IMAGE=rust:1.78-bookworm
BCL_DOCKER_HASKELL_IMAGE=haskell:9.8
BCL_DOCKER_PYTHON_IMAGE=python:3.11-bookworm

# ============================================================================
# TOOLCHAIN VERSIONS (minimum required)
# ============================================================================
BCL_MIN_GCC_VERSION=11
BCL_MIN_CLANG_VERSION=14
BCL_MIN_CMAKE_VERSION=3.20
BCL_MIN_GO_VERSION=1.21
BCL_MIN_RUST_VERSION=1.70
BCL_MIN_CARGO_VERSION=1.70
BCL_MIN_GHC_VERSION=9.4
BCL_MIN_CABAL_VERSION=3.8
BCL_MIN_PYTHON_VERSION=3.10
BCL_MIN_PIP_VERSION=22.0

# ============================================================================
# EXPERIMENT PARAMETERS
# ============================================================================
# Node counts for scalability experiments
BCL_SCALABILITY_NODE_COUNTS=4,7,10,16,25,50

# Transaction loads for throughput experiments
BCL_THROUGHPUT_LOADS=100,1000,10000,100000

# Network conditions
BCL_NET_LATENCY_MS=0,10,50,100,200
BCL_NET_JITTER_MS=0,5,10,20
BCL_NET_LOSS_PCT=0,0.1,1,5
BCL_NET_BANDWIDTH_MBPS=0,10,100,1000

# Fault tolerance scenarios
BCL_FAULT_SCENARIOS=node_crash,leader_crash,partition,byzantine,recovery

# ============================================================================
# METRICS COLLECTION
# ============================================================================
# Collection interval (seconds)
BCL_METRICS_INTERVAL=1

# System metrics to collect
BCL_COLLECT_CPU=true
BCL_COLLECT_MEMORY=true
BCL_COLLECT_NETWORK=true
BCL_COLLECT_DISK=false

# Prometheus (if using monitoring profile)
BCL_PROMETHEUS_URL=http://localhost:9090
BCL_GRAFANA_URL=http://localhost:3000

# ============================================================================
# REPORTING
# ============================================================================
# Chart settings
BCL_CHART_DPI=150
BCL_CHART_FORMAT=png
BCL_CHART_THEME=default

# Statistical confidence
BCL_CONFIDENCE_LEVEL=0.95

# ============================================================================
# LOGGING
# ============================================================================
BCL_LOG_LEVEL=INFO
BCL_LOG_DIR=./logs
BCL_LOG_MAX_SIZE_MB=100
BCL_LOG_MAX_FILES=10

# ============================================================================
# NETWORK SIMULATION (requires NET_ADMIN capability)
# ============================================================================
BCL_NETEM_ENABLED=false
BCL_NETEM_INTERFACE=eth0

# ============================================================================
# EXPERIMENT-SPECIFIC OVERRIDES
# ============================================================================
# Bitcoin
BCL_BITCOIN_NETWORK=regtest
BCL_BITCOIN_DATADIR=/tmp/bitcoin-regtest

# Ethereum (consensus specs - reference tests only)
BCL_ETHEREUM_SPEC_TESTS=true

# HotStuff
BCL_HOTSTUFF_NUM_REPLICAS=4

# Sui (Narwhal/Bullshark)
BCL_SUI_PROTOCOL_VERSION=latest

# Avalanche
BCL_AVALANCHE_NETWORK=local

# Algorand
BCL_ALGORAND_NETWORK=devnet

# CometBFT
BCL_COMETBFT_VERSION=v0.38

# Agave (Solana)
BCL_AGAVE_CLUSTER=localnet

# Ouroboros
BCL_OUROBOROS_ERA=conway

# HoneyBadgerBFT
BCL_HONEYBADGER_N=4
BCL_HONEYBADGER_F=1

# Rusty-Kaspa
BCL_KASPA_NETWORK=devnet

# Stellar Core
BCL_STELLAR_NETWORK=standalone